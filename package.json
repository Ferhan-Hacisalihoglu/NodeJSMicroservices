{
  "name": "nodejsmicroservices",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api-gateway" : "npm run dev -w apps/api-gateway",
    "dev:auth" : "npm run dev -w apps/auth-service",
    "dev:task" : "npm run dev -w apps/task-service",
    "dev:media" : "npm run dev -w apps/media-service",
    "dev:workflow" : "npm run dev -w apps/workflow-service",
    "db:migrate" : "tsx scripts/db-migrate.ts",
    "kafka:up" : "docker-compose -f docker/docker-compose.yml up -d",
    "kafka:down" : "docker-compose -f docker/docker-compose.yml down",
    "kafka:logs" : "docker-compose -f docker/docker-compose.yml logs -f kafka"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "dotenv": "18.0.8"
  }
}
